@page "/"
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión · UniEval UTSC</PageTitle>

<main class="acceso">
    <section class="acceso__contenido" aria-labelledby="titulo-acceso">
        <p class="acceso__marca">UniEval / UTSC</p>
        <h1 id="titulo-acceso">Tu opinión mejora la UTSC</h1>
        <p class="acceso__apoyo">Evalúa a tus docentes y a tu tutor del cuatrimestre desde tu celular. Son anónimas.</p>
        <div class="acceso__tarjeta">
            <h2>Iniciar sesión</h2>
            @if (AuthService.EntraConfigurado)
            {
                <button class="boton" aria-disabled="true" aria-describedby="ayuda-entra" disabled>Iniciar sesión con Microsoft 365</button>
                <p id="ayuda-entra" class="acceso__nota">Microsoft 365 aún no está configurado</p>
            }
            else
            {
                <label for="usuario-prueba">Usuario</label>
                <select id="usuario-prueba" @bind="_usuarioSeleccionado">
                    @foreach (var usuario in AuthService.UsuariosDePrueba())
                    {
                        <option value="@usuario.Id">@usuario.Nombre</option>
                    }
                </select>
                @if (UsuarioSeleccionado?.Roles.Count > 1)
                {
                    <label for="rol-prueba">Rol</label>
                    <select id="rol-prueba" @bind="_rolSeleccionado">
                        @foreach (var rol in UsuarioSeleccionado.Roles)
                        {
                            <option value="@rol">@AuthService.Etiqueta(rol)</option>
                        }
                    </select>
                }
                <button class="boton" @onclick="IniciarSesion">Entrar</button>
            }
        </div>
    </section>
</main>

@code {
    private string _usuarioSeleccionado = "1";
    private Rol _rolSeleccionado = Rol.Alumno;
    private UsuarioDePrueba? UsuarioSeleccionado => AuthService.UsuariosDePrueba().FirstOrDefault(usuario => usuario.Id == _usuarioSeleccionado);

    private async Task IniciarSesion()
    {
        var usuario = UsuarioSeleccionado ?? throw new InvalidOperationException("Selecciona un usuario.");
        var rol = usuario.Roles.Contains(_rolSeleccionado) ? _rolSeleccionado : usuario.Roles[0];
        await AuthService.SignInSimuladoAsync(rol, usuario.Id);
        Navigation.NavigateTo(AuthService.InicioPorRol(rol));
    }

}
