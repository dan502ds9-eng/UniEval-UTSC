@using UniEvalUtsc.Contracts.Enums
@inject IResultadosService ResultadosService

<section class="resultados-personal">
    @if (_cargando)
    {
        <p role="status">Cargando…</p>
    }
    else if (_error is not null)
    {
        <p role="alert">@_error</p>
    }
    else
    {
    <div class="resultado-segmentado" role="tablist" aria-label="@(Rol == Rol.Tutor ? "Grupo de tutoría" : "Materia y grupo")">
        @foreach (var elemento in _elementos)
        {
            <button type="button"
                    role="tab"
                    aria-selected="@(_elementoId == elemento.Id)"
                    class="@(_elementoId == elemento.Id ? "resultado-segmentado__activo" : null)"
                    @onclick="() => SeleccionarElementoAsync(elemento.Id)">
                @elemento.Nombre <small>@elemento.Contexto</small>
            </button>
        }
    </div>
    @if (_elemento is not null)
    {
        <section class="resultado-tarjeta resultado-historico">
            <h2>Promedio general por periodo</h2>
            <p>@_elemento.Nombre · @_elemento.Contexto</p>
            <GraficaHistorico Puntos="@_puntos" />
            <table class="tabla-resultados">
                <caption>Histórico de resultados por periodo</caption>
                <thead>
                    <tr><th scope="col">Periodo</th><th scope="col">Promedio</th><th scope="col">Nivel</th></tr>
                </thead>
                <tbody>
                    @foreach (var punto in _puntos)
                    {
                        <tr><td>@punto.Periodo</td><td>@punto.Promedio.ToString("0.0")</td><td><Pill Value="@punto.Promedio" MostrarValor="false" /></td></tr>
                    }
                </tbody>
            </table>
        </section>
    }
    }
</section>

@code {
    [Parameter] public Rol Rol { get; set; }

    private IReadOnlyList<ElementoResultado> _elementos = [];
    private IReadOnlyList<PuntoHistorico> _puntos = [];
    private string _elementoId = string.Empty;
    private ElementoResultado? _elemento;
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await CargarElementosAsync();
    }

    private async Task SeleccionarElementoAsync(string elementoId)
    {
        _elementoId = elementoId;
        await ActualizarHistoricoAsync();
    }

    private async Task CargarElementosAsync()
    {
        _cargando = true;
        _error = null;
        try
        {
            _elementos = await ResultadosService.ObtenerElementosAsync(Rol);
            _elementoId = _elementos.FirstOrDefault()?.Id ?? string.Empty;
            await ActualizarHistoricoAsync();
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;

        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task ActualizarHistoricoAsync()
    {
        _elemento = _elementos.SingleOrDefault(elemento => elemento.Id == _elementoId);
        if (_elemento is null)
        {
            _puntos = [];
            return;
        }

        _cargando = true;
        _error = null;
        try
        {
            _puntos = await ResultadosService.ObtenerHistoricoAsync(Rol, _elemento.Id);
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;

        }
        finally
        {
            _cargando = false;
        }
    }
}
