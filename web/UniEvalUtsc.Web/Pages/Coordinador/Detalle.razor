@page "/coordinador/detalle/{Tipo}/{Id}"
@attribute [Authorize(Roles = "Coordinador")]
@inject FiltrosState Filtros
@inject ICoordinacionService CoordinacionService
@inject IResultadosService ResultadosService

<PageTitle>Detalle de resultados · UniEval UTSC</PageTitle>
<ShellCoordinador Seccion="@Seccion">
    <ChildContent>
        @if (_cargando)
        {
            <p role="status">Cargando…</p>
        }
        else if (_error is not null)
        {
            <p role="alert">@_error</p>
        }
        else if (_resultado is null)
        {
            <p class="resultado-aviso" role="status">No hay un resultado disponible para mostrar con estos filtros.</p>
        }
        else
        {
            <DetalleResultado Resultado="@_resultado" EsTutor="@EsTutor" />
        }
    </ChildContent>
</ShellCoordinador>

@code {
    [Parameter] public string Tipo { get; set; } = string.Empty;
    [Parameter] public string Id { get; set; } = string.Empty;

    private ResultadoCoordinacion? _resultado;
    private bool _cargando = true;
    private string? _error;
    private bool EsTutor => string.Equals(Tipo, "tutor", StringComparison.OrdinalIgnoreCase);
    private string Seccion => EsTutor ? "resultados-tutores" : "resultados-docentes";

    protected override async Task OnInitializedAsync()
    {
        Filtros.InicializarPeriodo(await ResultadosService.ObtenerPeriodosAsync());
        Filtros.CambiarCarrera("dsm");
    }

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _error = null;
        if (!string.Equals(Tipo, "docente", StringComparison.OrdinalIgnoreCase) && !EsTutor)
        {
            _resultado = null;
            _cargando = false;
            return;
        }

        try
        {
            _resultado = (await CoordinacionService
            .ObtenerResultadosAsync(
                Filtros.PeriodoId,
                Filtros.Cuatrimestre,
                EsTutor,
                Filtros.CarreraId))
            .SingleOrDefault(resultado => string.Equals(resultado.Id, Id, StringComparison.Ordinal));
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;

        }
        finally
        {
            _cargando = false;
        }
    }
}
