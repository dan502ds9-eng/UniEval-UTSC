@page "/alumno/comprobante"
@attribute [Authorize(Roles = "Alumno")]
@inject NavigationManager Navigation
@inject IAlumnoService AlumnoService

<PageTitle>Comprobante · UniEval UTSC</PageTitle>

@if (_cargando)
{
    <p class="student-home" role="status">Cargando…</p>
}
else if (_error is not null)
{
    <p class="student-home" role="alert">@_error</p>
}
else if (_comprobante is not null)
{
    <main class="student-home alumno-pagina alumno-comprobante">
        <span class="alumno-comprobante__sello">COMPROBANTE</span>
        <h1 tabindex="-1">¡Gracias!</h1>
        <p>Contestaste las @_comprobante.EncuestasContestadas de @_comprobante.TotalEncuestas encuestas del cuatrimestre. Puedes mostrar esta pantalla a tu tutor.</p>
        @if (_comprobante.FechaEnvio is { } fechaEnvio)
        {
            <p class="alumno-comprobante__fecha">@fechaEnvio.ToString("dd/MM/yyyy") · @_comprobante.Periodo</p>
        }
        else
        {
            <p class="alumno-comprobante__fecha">@_comprobante.Periodo</p>
        }
        <button class="boton boton--contorno" type="button" @onclick="VolverAEncuestas">← Mis encuestas</button>
    </main>
}

@code {
    private ComprobanteAlumno? _comprobante;
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _comprobante = await AlumnoService.ObtenerComprobanteAsync();
            if (_comprobante is null)
            {
                Navigation.NavigateTo("/alumno");
            }
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;

        }
        finally
        {
            _cargando = false;
        }
    }

    private void VolverAEncuestas() => Navigation.NavigateTo("/alumno");
}
