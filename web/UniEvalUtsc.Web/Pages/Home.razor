@page "/"
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión · UniEval UTSC</PageTitle>

<main class="acceso">
    <section class="acceso__contenido" aria-labelledby="titulo-acceso">
        <p class="acceso__marca">UniEval / UTSC</p>
        <h1 id="titulo-acceso">Tu opinión mejora la UTSC</h1>
        <p class="acceso__apoyo">Evalúa a tus docentes y a tu tutor del cuatrimestre desde tu celular. Son anónimas.</p>
        <div class="acceso__tarjeta">
            <h2>Iniciar sesión</h2>
            <p class="acceso__simulacion">Simulación: elige con qué cuenta entras.</p>
            <label for="rol-acceso">Tipo de usuario</label>
            <select id="rol-acceso" @bind="_rolSeleccionado">
                @foreach (var rol in _roles)
                {
                    <option value="@rol">@AuthService.Etiqueta(rol)</option>
                }
            </select>
            @if (AuthService.EntraConfigurado)
            {
                <p class="acceso__nota" role="status">Microsoft Entra ID está configurado como proveedor, pero su integración sigue pendiente.</p>
                <button class="boton" disabled>Iniciar sesión con Microsoft 365</button>
            }
            else
            {
                <button class="boton" @onclick="IniciarSesion">Iniciar sesión con Microsoft 365</button>
                <p class="acceso__nota">Usa tu cuenta institucional. No guardamos contraseñas.</p>
            }
        </div>
    </section>
</main>

@code {
    private readonly Rol[] _roles = Enum.GetValues<Rol>();
    private Rol _rolSeleccionado = Rol.Alumno;

    private async Task IniciarSesion()
    {
        if (_rolSeleccionado == Rol.Alumno)
        {
            await AuthService.SignInSimuladoAsync(_rolSeleccionado);
            Navigation.NavigateTo(AuthService.InicioPorRol(_rolSeleccionado));
            return;
        }

        Navigation.NavigateTo($"/acceso/{_rolSeleccionado}");
    }
}
