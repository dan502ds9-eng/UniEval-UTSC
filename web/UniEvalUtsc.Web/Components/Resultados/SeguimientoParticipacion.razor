@inject ICoordinacionService CoordinacionService

<section class="coordinacion-contenido">
    @if (_cargando)
    {
        <p role="status">Cargando…</p>
    }
    else if (_error is not null)
    {
        <p role="alert">@_error</p>
    }
    else
    {
        <IndicadoresGestion Resumen="@_resumen" />
        <div class="tarjetas-participacion">
            @foreach (var grupo in _grupos)
            {
                <TarjetaParticipacionGrupo @key="grupo.Id"
                                           Grupo="@grupo"
                                           CarreraId="@CarreraId"
                                           OnRecordatorioEnviado="OnRecordatorioEnviado" />
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string PeriodoId { get; set; } = string.Empty;
    [Parameter] public string Cuatrimestre { get; set; } = "todos";
    [Parameter] public string CarreraId { get; set; } = FiltrosState.CarreraCoordinadorId;
    [Parameter] public EventCallback<GrupoParticipacion> OnRecordatorioEnviado { get; set; }

    private IReadOnlyList<GrupoParticipacion> _grupos = [];
    private ResumenCoordinacion _resumen = new(0, 0, 0, 0, 0);
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _error = null;
        try
        {
            _resumen = await CoordinacionService.ObtenerResumenAsync(PeriodoId, Cuatrimestre, CarreraId);
            _grupos = await CoordinacionService.ObtenerGruposAsync(PeriodoId, Cuatrimestre, CarreraId);
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _cargando = false;
        }
    }
}
