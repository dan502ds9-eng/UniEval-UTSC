@page "/acceso/{RutaRol}"
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>@(AuthService.Etiqueta(_rol)) · UniEval UTSC</PageTitle>

<main class="acceso-personal">
    <section class="acceso-personal__contenido" aria-labelledby="titulo-acceso-personal">
        <div class="acceso-personal__tarjeta">
            <p class="acceso-personal__etiqueta">ACCESO DE PERSONAL</p>
            <h1 id="titulo-acceso-personal">@AuthService.Etiqueta(_rol)</h1>
            @if (AuthService.EntraConfigurado)
            {
                <button class="boton" type="button" aria-disabled="true" aria-describedby="ayuda-entra" disabled>Iniciar sesión con Microsoft 365</button>
                <p id="ayuda-entra" class="acceso__nota">Microsoft 365 aún no está configurado</p>
            }
            else
            {
                <label for="usuario-prueba">Usuario</label>
                <select id="usuario-prueba" @bind="_usuarioSeleccionado">
                    @foreach (var usuario in AuthService.UsuariosDePrueba(_rol))
                    {
                        <option value="@usuario.Id">@usuario.Nombre</option>
                    }
                </select>
                <button class="boton" type="button" @onclick="IniciarSesionSimulada">Entrar</button>
            }
        </div>
    </section>
</main>

@code {
    [Parameter] public string RutaRol { get; set; } = string.Empty;

    private Rol _rol;
    private string _usuarioSeleccionado = string.Empty;

    protected override void OnParametersSet()
    {
        if (!Enum.TryParse<Rol>(RutaRol, ignoreCase: true, out _rol) || _rol == Rol.Alumno)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        _usuarioSeleccionado = AuthService.UsuariosDePrueba(_rol).First().Id;
    }

    private async Task IniciarSesionSimulada()
    {
        await AuthService.SignInSimuladoAsync(_rol, _usuarioSeleccionado);
        Navigation.NavigateTo(AuthService.InicioPorRol(_rol));
    }

}
