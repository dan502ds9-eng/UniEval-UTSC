@page "/"
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión · UniEval UTSC</PageTitle>

<main class="acceso">
    <section class="acceso__contenido" aria-labelledby="titulo-acceso">
        <p class="acceso__marca">UniEval / UTSC</p>
        <h1 id="titulo-acceso">Tu opinión mejora la UTSC</h1>
        <p class="acceso__apoyo">Evalúa a tus docentes y a tu tutor del cuatrimestre desde tu celular. Son anónimas.</p>
        <div class="acceso__tarjeta">
            <h2>Iniciar sesión</h2>
            @if (AuthService.EntraConfigurado)
            {
                <button class="boton" aria-disabled="true" aria-describedby="ayuda-entra" disabled>Iniciar sesión con Microsoft 365</button>
                <p id="ayuda-entra" class="acceso__nota">Microsoft 365 aún no está configurado</p>
            }
            else
            {
                <p class="acceso__simulacion">Simulado</p>
                <label for="usuario-prueba">Usuario de prueba</label>
                <select id="usuario-prueba" @bind="_usuarioSeleccionado">
                    @foreach (var usuario in AuthService.UsuariosDePrueba())
                    {
                        <option value="@($"{usuario.Rol}|{usuario.Id}")">@usuario.Nombre · @AuthService.Etiqueta(usuario.Rol)</option>
                    }
                </select>
                <button class="boton" @onclick="IniciarSesion">Entrar (modo demo)</button>
            }
        </div>
    </section>
</main>

@code {
    private string _usuarioSeleccionado = "Alumno|1";

    private async Task IniciarSesion()
    {
        var partes = _usuarioSeleccionado.Split('|', 2);
        var rol = Enum.Parse<Rol>(partes[0]);
        await AuthService.SignInSimuladoAsync(rol, partes[1]);
        Navigation.NavigateTo(AuthService.InicioPorRol(rol));
    }

}
