@using UniEvalUtsc.Contracts.Enums
@inject IResultadosService ResultadosService
@inject UnievalJsInterop JsInterop

<section class="resultados-personal">
    @if (_cargando)
    {
        <p role="status">Cargando…</p>
    }
    else if (_error is not null)
    {
        <p role="alert">@_error</p>
    }
    else
    {
    <table class="tabla-resultados">
        <caption>Reportes por periodo y @(Rol == Rol.Tutor ? "grupo de tutoría" : "materia")</caption>
        <thead>
            <tr><th scope="col">Periodo</th><th scope="col">@(Rol == Rol.Tutor ? "Grupo" : "Materia")</th><th scope="col">Promedio</th><th scope="col">Nivel</th><th scope="col">Reporte</th></tr>
        </thead>
        <tbody>
            @foreach (var reporte in _reportes)
            {
                <tr>
                    <td>@reporte.Periodo</td>
                    <td><strong>@reporte.ElementoNombre</strong><small class="tabla-resultados__secundario">@reporte.Contexto</small></td>
                    <td>@reporte.Promedio.ToString("0.0")</td>
                    <td><Pill Value="@reporte.Promedio" MostrarValor="false" /></td>
                    <td><button class="boton boton--contorno" type="button" @onclick="() => DescargarPdfAsync(reporte)">Descargar PDF</button></td>
                </tr>
            }
        </tbody>
    </table>
    }
</section>

@code {
    [Parameter] public Rol Rol { get; set; }
    private IReadOnlyList<FilaReportePersonal> _reportes = [];
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _reportes = await ResultadosService.ObtenerReportesAsync(Rol);
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;

        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task DescargarPdfAsync(FilaReportePersonal reporte)
    {
        _ = reporte;
        await JsInterop.PrintAsync();
    }
}
