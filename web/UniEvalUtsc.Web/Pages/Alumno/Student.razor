@page "/alumno"
@page "/alumno/encuesta"
@page "/alumno/comprobante"
@attribute [Authorize(Roles = "Alumno")]
@implements IDisposable
@inject NavigationManager Navigation
@inject AlumnoInMemoryService AlumnoService
@inject AuthService AuthService
@inject UnievalJsInterop JsInterop

<PageTitle>@Titulo · UniEval UTSC</PageTitle>

@if (_evaluacion is not null)
{
    @if (Seccion == "encuesta")
    {
        <main class="student-home alumno-pagina alumno-encuesta">
            <div class="alumno-encuesta__encabezado">
                <button class="boton boton--contorno" type="button" @onclick="VolverAEncuestas">← Mis encuestas</button>
                <span class="alumno-etiqueta">@_evaluacion.Grupo</span>
            </div>
            <h1 tabindex="-1">@(_evaluacion.EsEstadia ? "Evaluación de tu tutor de estadías" : "Evaluación del cuatrimestre")</h1>

            <section class="alumno-resumen" aria-label="Resumen de la evaluación">
                <div class="alumno-resumen__bloque">
                    <span class="alumno-resumen__icono" aria-hidden="true">▣</span>
                    <div><small>Periodo actual</small><strong>@_evaluacion.Periodo</strong><span>Cuatrimestre en curso</span></div>
                </div>
                <div class="alumno-resumen__bloque">
                    <span class="alumno-resumen__icono" aria-hidden="true">▤</span>
                    <div><small>Preguntas</small><strong>@_evaluacion.Preguntas.Count</strong><span>Formato @_evaluacion.Formato</span></div>
                </div>
                <div class="alumno-resumen__bloque">
                    <span class="alumno-resumen__icono" aria-hidden="true">♙</span>
                    <div><small>Evaluados</small><strong>@_evaluacion.Evaluados.Count</strong><span>@(_evaluacion.EsEstadia ? "Tutor de estadías" : $"{_evaluacion.Evaluados.Count - 1} docentes · 1 tutora")</span></div>
                </div>
            </section>

            <section class="alumno-avance alumno-avance--sticky" aria-label="Avance de la evaluación">
                <div class="alumno-avance__encabezado">
                    <strong>@AvanceRespuestas de @_evaluacion.TotalRespuestas respondidas</strong>
                    <button class="boton-enlace" type="button" @onclick="IrASiguientePendiente" disabled="@(_preguntaPendiente is null)">
                        Ir a la siguiente pendiente →
                    </button>
                </div>
                <BarraProgreso Valor="@AvanceRespuestas" Maximo="@_evaluacion.TotalRespuestas" Label="Avance de la evaluación" />
                <div class="alumno-leyenda" aria-label="Escala: 1 a 4 bajo, 5 a 7 medio, 8 a 10 alto">
                    <span>Escala:</span><span class="alumno-leyenda__bajo">1–4 Bajo</span><span class="alumno-leyenda__medio">5–7 Medio</span><span class="alumno-leyenda__alto">8–10 Alto</span>
                </div>
            </section>

            <p class="sr-only">Cada pregunta es una sección que se abre y se cierra. Califica del 1 al 10. Las teclas del 0 al 9 eligen una calificación y el 0 cuenta como 10.</p>

            <div class="alumno-preguntas">
                @foreach (var pregunta in _evaluacion.Preguntas)
                {
                    var preguntaCompleta = PreguntaCompleta(pregunta.Id);
                    var completados = RespuestasDePregunta(pregunta.Id);
                    <section class="alumno-pregunta @(preguntaCompleta ? "alumno-pregunta--completa" : null)" id="@($"pregunta-{pregunta.Id}")">
                        <h2 class="alumno-pregunta__cabecera">
                            <button type="button"
                                    aria-expanded="@(_preguntaAbierta == pregunta.Id)"
                                    aria-controls="@($"contenido-pregunta-{pregunta.Id}")"
                                    @onclick="() => AlternarPregunta(pregunta.Id)">
                                <span class="alumno-pregunta__numero">Pregunta @pregunta.Id</span>
                                <span class="alumno-pregunta__texto">@pregunta.Texto</span>
                                <span class="alumno-pregunta__avance">@((preguntaCompleta ? "✓ Completa" : $"{completados} / {_evaluacion.Evaluados.Count}"))</span>
                            </button>
                        </h2>
                        @if (_preguntaAbierta == pregunta.Id)
                        {
                            <div class="alumno-pregunta__contenido" id="@($"contenido-pregunta-{pregunta.Id}")">
                                <button class="boton boton--contorno alumno-escuchar" type="button" @onclick="() => EscucharPreguntaAsync(pregunta)">
                                    🔊 Escuchar pregunta
                                </button>
                                <div class="alumno-evaluados">
                                    @for (var indice = 0; indice < _evaluacion.Evaluados.Count; indice++)
                                    {
                                        var indiceEvaluado = indice;
                                        var evaluado = _evaluacion.Evaluados[indice];
                                        var clave = AlumnoInMemoryService.LlaveCalificacion(pregunta.Id, evaluado.Id);
                                        <fieldset class="alumno-evaluado @(evaluado.EsTutor ? "alumno-evaluado--tutor" : null)" role="radiogroup" aria-label="@($"Calificación para {evaluado.Etiqueta}: {evaluado.Nombre}")">
                                            <legend class="sr-only">@($"Calificación para {evaluado.Etiqueta}: {evaluado.Nombre}")</legend>
                                            <div class="alumno-evaluado__persona">
                                                <span class="alumno-evaluado__numero">@(indice + 1).</span>
                                                <span><small>@evaluado.Materia</small><strong>@evaluado.Nombre</strong></span>
                                                @if (evaluado.EsTutor)
                                                {
                                                    <span class="alumno-evaluado__distintivo">@evaluado.Etiqueta</span>
                                                }
                                            </div>
                                            <div class="alumno-calificaciones">
                                                @for (var calificacion = 1; calificacion <= 10; calificacion++)
                                                {
                                                    var valor = calificacion;
                                                    var inputId = IdCalificacion(pregunta.Id, evaluado.Id, valor);
                                                    <label class="alumno-calificacion alumno-calificacion--@valor" for="@inputId">
                                                        <input id="@inputId"
                                                               type="radio"
                                                               name="@($"calificacion-{pregunta.Id}-{evaluado.Id}")"
                                                               value="@valor"
                                                               checked="@EsSeleccionada(clave, valor)"
                                                               aria-label="@($"{valor} de 10, {Nivel(valor)}")"
                                                               @onchange="() => CalificarAsync(pregunta.Id, indiceEvaluado, evaluado.Id, valor, false)"
                                                               @onkeydown="evento => ManejarTeclaAsync(evento, pregunta.Id, indiceEvaluado, evaluado.Id)" />
                                                        <span aria-hidden="true">@valor</span>
                                                    </label>
                                                }
                                            </div>
                                        </fieldset>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                }
            </div>

            <p class="alumno-estado" role="status" aria-live="polite">@TextoAvance</p>
            @if (!_evaluacion.PeriodoAbierto)
            {
                <p class="alumno-aviso" role="status">El periodo está cerrado y no recibe respuestas.</p>
            }
        </main>
        <footer class="alumno-pie alumno-pie--sticky">
            <div class="alumno-pie__contenido">
                <button class="boton boton--contorno" type="button" @onclick="GuardarBorradorYSalirAsync">Guardar borrador y salir</button>
                <button id="boton-enviar-evaluacion" class="boton" type="button" disabled="@(!PuedeEnviar)" @onclick="() => _dialogoEnvio = true">Enviar evaluación</button>
            </div>
        </footer>
        <Dialogo IsOpen="@_dialogoEnvio"
                 IsOpenChanged="CambiarDialogo"
                 Title="¿Enviar tu evaluación?"
                 OnClosed="RestaurarFocoEnvio">
            <ChildContent>
                <p>Una vez enviada, tu evaluación no se puede modificar. ¿Deseas continuar?</p>
            </ChildContent>
            <Footer>
                <button class="boton boton--contorno" type="button" @onclick="() => _dialogoEnvio = false">Revisar respuestas</button>
                <button class="boton" type="button" @onclick="EnviarEvaluacionAsync">Confirmar envío</button>
            </Footer>
        </Dialogo>
        <Toast Message="@_toast" Visible="@(!string.IsNullOrWhiteSpace(_toast))" />
    }
    else if (Seccion == "comprobante")
    {
        <main class="student-home alumno-pagina alumno-comprobante">
            <span class="alumno-comprobante__sello">COMPROBANTE</span>
            <h1 tabindex="-1">¡Gracias!</h1>
            <p>Contestaste las @_evaluacion.Evaluados.Count encuestas del cuatrimestre. Puedes mostrar esta pantalla a tu tutor.</p>
            <p class="alumno-comprobante__fecha">@(_evaluacion.FechaEnvio?.ToString("dd/MM/yyyy") ?? DateOnly.FromDateTime(DateTime.Today).ToString("dd/MM/yyyy")) · @_evaluacion.Periodo</p>
            <button class="boton boton--contorno" type="button" @onclick="VolverAEncuestas">← Mis encuestas</button>
        </main>
    }
    else
    {
        <main class="student-home alumno-pagina">
            <h1 tabindex="-1">Mis encuestas</h1>
            <p class="alumno-introduccion">Consulta y contesta tus evaluaciones del periodo actual.</p>
            <section class="alumno-resumen-home" aria-label="Avance de encuestas">
                <strong>@(_evaluacion.Enviado ? _evaluacion.Evaluados.Count : 0) de @_evaluacion.Evaluados.Count contestadas</strong>
                <BarraProgreso Valor="@(_evaluacion.Enviado ? _evaluacion.Evaluados.Count : 0)" Maximo="@_evaluacion.Evaluados.Count" Label="Encuestas contestadas" />
            </section>
            <article class="alumno-tarjeta">
                <header>
                    <div><span class="alumno-etiqueta">@_evaluacion.Periodo</span><h2>@(_evaluacion.EsEstadia ? "Evaluación de tutor de estadías" : "Evaluación del cuatrimestre")</h2></div>
                    <span class="alumno-tarjeta__formato">@_evaluacion.Formato</span>
                </header>
                <ul class="alumno-lista-evaluados">
                    @for (var indice = 0; indice < _evaluacion.Evaluados.Count; indice++)
                    {
                        var evaluado = _evaluacion.Evaluados[indice];
                        var respuestas = RespuestasDeEvaluado(evaluado.Id);
                        <li class="@(evaluado.EsTutor ? "alumno-lista-evaluados__tutor" : null)">
                            <span class="alumno-lista-evaluados__numero">@(indice + 1).</span>
                            <span class="alumno-lista-evaluados__datos"><strong>@evaluado.Materia</strong><span>@evaluado.Nombre</span></span>
                            <span class="alumno-lista-evaluados__estado">@(EstadoEvaluado(respuestas))</span>
                        </li>
                    }
                </ul>
                @if (!_evaluacion.PeriodoAbierto && !_evaluacion.Enviado)
                {
                    <p class="alumno-aviso">El periodo no está abierto. No es posible contestar por el momento.</p>
                }
                <button class="boton" type="button" disabled="@(!_evaluacion.PeriodoAbierto || _evaluacion.Enviado)" @onclick="AbrirEncuesta">
                    @(_calificaciones.Count > 0 ? "Continuar evaluación" : "Contestar evaluación")
                </button>
                @if (_evaluacion.Enviado)
                {
                    <button class="boton boton--contorno" type="button" @onclick="AbrirComprobante">Ver comprobante</button>
                }
            </article>
            <Toast Message="@_toast" Visible="@(!string.IsNullOrWhiteSpace(_toast))" />
        </main>
    }
}

@code {
    private EvaluacionAlumno? _evaluacion;
    private Dictionary<string, int> _calificaciones = [];
    private int? _preguntaAbierta;
    private bool _dialogoEnvio;
    private string? _toast;

    private string Seccion => Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/').Split('/').LastOrDefault() switch
    {
        "encuesta" => "encuesta",
        "comprobante" => "comprobante",
        _ => "inicio"
    };

    private string Titulo => Seccion switch
    {
        "encuesta" => "Evaluación del cuatrimestre",
        "comprobante" => "Comprobante",
        _ => "Mis encuestas"
    };

    private int AvanceRespuestas => _calificaciones.Count;
    private int? _preguntaPendiente => _evaluacion?.Preguntas.FirstOrDefault(pregunta => !PreguntaCompleta(pregunta.Id))?.Id;
    private bool PuedeEnviar => _evaluacion is { PeriodoAbierto: true, Enviado: false } &&
        AvanceRespuestas == _evaluacion.TotalRespuestas;
    private string TextoAvance => _evaluacion is null
        ? string.Empty
        : PuedeEnviar
            ? "Evaluación completa. Ya puedes enviarla."
            : $"Faltan {_evaluacion.TotalRespuestas - AvanceRespuestas} respuestas por contestar.";

    protected override async Task OnInitializedAsync()
    {
        _evaluacion = AlumnoService.ObtenerEvaluacion();
        var usuario = AuthService.CurrentUser?.Name ?? "alumno";
        _calificaciones = await AlumnoService.RecuperarBorradorAsync(usuario);
        _preguntaAbierta = _evaluacion.Preguntas.FirstOrDefault(pregunta => !PreguntaCompleta(pregunta.Id))?.Id
            ?? _evaluacion.Preguntas.FirstOrDefault()?.Id;

        if (Seccion == "encuesta" && _evaluacion.Enviado)
        {
            Navigation.NavigateTo("/alumno/comprobante");
            return;
        }

        if (Seccion == "comprobante" && !_evaluacion.Enviado)
        {
            Navigation.NavigateTo("/alumno");
            return;
        }

        if (Seccion == "inicio" && Navigation.Uri.Contains("borrador=guardado", StringComparison.Ordinal))
        {
            _toast = "✓ Borrador guardado. Continúa cuando quieras desde Mis encuestas.";
        }
        else if (Seccion == "inicio" && Navigation.Uri.Contains("borrador=error", StringComparison.Ordinal))
        {
            _toast = "No se pudo guardar el borrador. Intenta de nuevo.";
        }
    }

    protected override void OnInitialized() =>
        Navigation.LocationChanged += ManejarCambioDeRuta;

    private bool PreguntaCompleta(int preguntaId) =>
        _evaluacion is not null &&
        _evaluacion.Evaluados.All(evaluado =>
            _calificaciones.ContainsKey(AlumnoInMemoryService.LlaveCalificacion(preguntaId, evaluado.Id)));

    private int RespuestasDePregunta(int preguntaId) =>
        _evaluacion?.Evaluados.Count(evaluado =>
            _calificaciones.ContainsKey(AlumnoInMemoryService.LlaveCalificacion(preguntaId, evaluado.Id))) ?? 0;

    private int RespuestasDeEvaluado(string evaluadoId) =>
        _evaluacion?.Preguntas.Count(pregunta =>
            _calificaciones.ContainsKey(AlumnoInMemoryService.LlaveCalificacion(pregunta.Id, evaluadoId))) ?? 0;

    private string EstadoEvaluado(int respuestas)
    {
        if (_evaluacion is null)
        {
            return "Pendiente";
        }

        if (_evaluacion.Enviado)
        {
            return "Contestada";
        }

        return respuestas == 0
            ? "Pendiente"
            : $"Borrador guardado · {respuestas} de {_evaluacion.Preguntas.Count}";
    }

    private bool EsSeleccionada(string clave, int valor) =>
        _calificaciones.TryGetValue(clave, out var elegida) && elegida == valor;

    private static string IdCalificacion(int preguntaId, string evaluadoId, int valor) =>
        $"cal-{preguntaId}-{evaluadoId}-{valor}";

    private static string Nivel(int calificacion) => calificacion <= 4 ? "bajo" : calificacion <= 7 ? "medio" : "alto";

    private void AlternarPregunta(int preguntaId) =>
        _preguntaAbierta = _preguntaAbierta == preguntaId ? null : preguntaId;

    private async Task ManejarTeclaAsync(KeyboardEventArgs evento, int preguntaId, int indiceEvaluado, string evaluadoId)
    {
        if (evento.Key.Length != 1 || evento.Key[0] is < '0' or > '9')
        {
            return;
        }

        var calificacion = evento.Key == "0" ? 10 : int.Parse(evento.Key, System.Globalization.CultureInfo.InvariantCulture);
        await CalificarAsync(preguntaId, indiceEvaluado, evaluadoId, calificacion, true);
    }

    private async Task CalificarAsync(int preguntaId, int indiceEvaluado, string evaluadoId, int calificacion, bool avanzar)
    {
        var clave = AlumnoInMemoryService.LlaveCalificacion(preguntaId, evaluadoId);
        _calificaciones[clave] = calificacion;
        var guardado = await AlumnoService.GuardarBorradorAsync(AuthService.CurrentUser?.Name ?? "alumno", _calificaciones);
        if (!guardado)
        {
            _toast = "No se pudo guardar el borrador en este dispositivo.";
        }

        if (PreguntaCompleta(preguntaId))
        {
            _preguntaAbierta = _preguntaPendiente;
            if (_preguntaAbierta is { } siguiente)
            {
                var primerEvaluado = _evaluacion!.Evaluados.First(e =>
                    !_calificaciones.ContainsKey(AlumnoInMemoryService.LlaveCalificacion(siguiente, e.Id)));
                await InvokeAsync(StateHasChanged);
                await Task.Yield();
                await JsInterop.FocusByIdAsync(IdCalificacion(siguiente, primerEvaluado.Id, 1));
            }
            else
            {
                _preguntaAbierta = preguntaId;
                await InvokeAsync(StateHasChanged);
                await Task.Yield();
                await JsInterop.FocusByIdAsync("boton-enviar-evaluacion");
            }
        }
        else if (avanzar && indiceEvaluado + 1 < _evaluacion!.Evaluados.Count)
        {
            var siguiente = _evaluacion.Evaluados[indiceEvaluado + 1];
            await Task.Yield();
            await JsInterop.FocusByIdAsync(IdCalificacion(preguntaId, siguiente.Id, 1));
        }
    }

    private async Task IrASiguientePendiente()
    {
        if (_preguntaPendiente is not { } preguntaId || _evaluacion is null)
        {
            return;
        }

        _preguntaAbierta = preguntaId;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        var evaluado = _evaluacion.Evaluados.First(e =>
            !_calificaciones.ContainsKey(AlumnoInMemoryService.LlaveCalificacion(preguntaId, e.Id)));
        await JsInterop.FocusByIdAsync(IdCalificacion(preguntaId, evaluado.Id, 1));
    }

    private async Task EscucharPreguntaAsync(PreguntaAlumno pregunta)
    {
        await JsInterop.SpeakAsync($"Pregunta {pregunta.Id} de {_evaluacion!.Preguntas.Count}. {pregunta.Texto}");
    }

    private async Task GuardarBorradorYSalirAsync()
    {
        var guardado = await AlumnoService.GuardarBorradorAsync(AuthService.CurrentUser?.Name ?? "alumno", _calificaciones);
        Navigation.NavigateTo(guardado ? "/alumno?borrador=guardado" : "/alumno?borrador=error");
    }

    private void VolverAEncuestas() => Navigation.NavigateTo("/alumno");
    private void AbrirEncuesta() => Navigation.NavigateTo("/alumno/encuesta");
    private void AbrirComprobante() => Navigation.NavigateTo("/alumno/comprobante");

    private void ManejarCambioDeRuta(object? sender, LocationChangedEventArgs args)
    {
        _ = sender;
        _evaluacion = AlumnoService.ObtenerEvaluacion();

        if (Seccion == "inicio")
        {
            _toast = args.Location.Contains("borrador=guardado", StringComparison.Ordinal)
                ? "✓ Borrador guardado. Continúa cuando quieras desde Mis encuestas."
                : args.Location.Contains("borrador=error", StringComparison.Ordinal)
                    ? "No se pudo guardar el borrador. Intenta de nuevo."
                    : null;
        }

        if (Seccion == "encuesta" && _evaluacion.Enviado)
        {
            Navigation.NavigateTo("/alumno/comprobante");
            return;
        }

        if (Seccion == "comprobante" && !_evaluacion.Enviado)
        {
            Navigation.NavigateTo("/alumno");
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private Task CambiarDialogo(bool abierto)
    {
        _dialogoEnvio = abierto;
        return Task.CompletedTask;
    }

    private Task RestaurarFocoEnvio() => Task.CompletedTask;

    private async Task EnviarEvaluacionAsync()
    {
        if (!PuedeEnviar)
        {
            return;
        }

        var resultado = await AlumnoService.EnviarAsync(AuthService.CurrentUser?.Name ?? "alumno", _calificaciones);
        if (!resultado.Exitoso)
        {
            _toast = resultado.Mensaje;
            _dialogoEnvio = false;
            return;
        }

        _dialogoEnvio = false;
        Navigation.NavigateTo("/alumno/comprobante");
    }

    public void Dispose() =>
        Navigation.LocationChanged -= ManejarCambioDeRuta;
}
