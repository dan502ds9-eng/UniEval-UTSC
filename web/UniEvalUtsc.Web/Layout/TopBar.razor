@implements IDisposable
@inject AuthService AuthService
@inject IAlumnoService AlumnoService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<header class="@CssClass">
    <a class="topbar__marca" href="/" aria-label="UniEval UTSC, inicio">
        <span class="topbar__simbolo" aria-hidden="true">U</span>
        <span><strong>UniEval</strong><small>UTSC</small></span>
    </a>
    <nav class="topbar__acciones" aria-label="Preferencias y cuenta">
        @if (AuthService.CurrentUser?.Role == Rol.Alumno)
        {
            <button class="topbar__boton topbar__notificaciones"
                    type="button"
                    aria-label="@($"Notificaciones, {TextoMensajesSinLeer}")"
                    aria-haspopup="dialog"
                    @onclick="AbrirMensajes">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                    <path d="M10 21h4" />
                </svg>
                @if (_mensajesSinLeer > 0)
                {
                    <span class="topbar__campana-conteo">@_mensajesSinLeer</span>
                }
            </button>
        }

        <div class="topbar__menu-contenedor">
            <button @ref="_textoTrigger"
                    class="topbar__boton"
                    type="button"
                    aria-haspopup="menu"
                    aria-controls="menu-tamano-texto"
                    aria-expanded="@_textoAbierto"
                    @onclick="ToggleTextMenu">Aa</button>
            <div id="menu-tamano-texto" @ref="_textoMenu" class="topbar__menu" role="menu" hidden="@(!_textoAbierto)" aria-label="Tamaño del texto">
                @foreach (var tamaño in _tamanosTexto)
                {
                    <button type="button"
                            role="menuitemradio"
                            aria-checked="@(_escala == tamaño ? "true" : "false")"
                            @onclick="() => CambiarEscala(tamaño)">
                        <span>@EtiquetaEscala(tamaño)</span>
                        @if (_escala == tamaño)
                        {
                            <span aria-hidden="true">✓</span>
                        }
                    </button>
                }
            </div>
        </div>

        <button class="topbar__boton topbar__tema"
                type="button"
                aria-label="@(_tema == "dark" ? "Cambiar a tema claro" : "Cambiar a tema oscuro")"
                @onclick="CambiarTema">
            @if (_tema == "dark")
            {
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="4.2" />
                    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" />
                </svg>
            }
            else
            {
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 14.5A8 8 0 1 1 9.5 4 6.5 6.5 0 0 0 20 14.5z" />
                </svg>
            }
        </button>

        @if (AuthService.CurrentUser is { } usuario)
        {
            <div class="topbar__menu-contenedor">
                <button @ref="_usuarioTrigger"
                        class="topbar__usuario"
                        type="button"
                        aria-haspopup="menu"
                        aria-controls="menu-cuenta-usuario"
                        aria-expanded="@_usuarioAbierto"
                        @onclick="ToggleUserMenu">
                    <span class="topbar__iniciales">@usuario.Initials</span>
                    <span class="topbar__rol">@AuthService.Etiqueta(usuario.Role)</span>
                </button>
                <div id="menu-cuenta-usuario" @ref="_usuarioMenu" class="topbar__menu topbar__menu--usuario" role="menu" hidden="@(!_usuarioAbierto)" aria-label="Cuenta de usuario">
                    <div class="topbar__perfil">
                        <strong>@usuario.Name</strong>
                        <span>@AuthService.Etiqueta(usuario.Role)</span>
                    </div>
                    <button type="button" role="menuitem" @onclick="CerrarSesion">Cerrar sesión</button>
                </div>
            </div>
        }
    </nav>
    @if (_notificacionEmergente)
    {
        <div class="topbar__notificacion-emergente" role="status">
            <p>Tienes @TextoMensajesSinLeer.</p>
            <button type="button" @onclick="AbrirMensajes">Ver mensaje</button>
            <button type="button" aria-label="Cerrar notificación" @onclick="() => _notificacionEmergente = false">Cerrar</button>
        </div>
    }
    <PanelLateral @bind-IsOpen="_panelMensajesAbierto" Title="Mensajes">
        <div class="alumno-mensajes__encabezado">
            @if (_cargandoMensajes)
            {
                <p role="status">Cargando…</p>
            }
            else if (_errorMensajes is not null)
            {
                <p role="alert">@_errorMensajes</p>
            }
            else
            {
                <p role="status">@(_mensajesSinLeer == 0 ? "Todo leído" : TextoMensajesSinLeer)</p>
                @if (_mensajesSinLeer > 0)
                {
                    <button class="boton-enlace" type="button" @onclick="MarcarTodosComoLeidosAsync">Marcar todos como leídos</button>
                }
            }
        </div>
        <ul class="alumno-mensajes">
            @foreach (var mensaje in _mensajes)
            {
                <li class="@(mensaje.Leido ? null : "alumno-mensajes__nuevo")">
                    <small>@mensaje.Remitente · @mensaje.Fecha.ToString("dd/MM/yyyy") @if (!mensaje.Leido) { <strong>· Nuevo</strong> }</small>
                    <h3>@mensaje.Titulo</h3>
                    <p>@mensaje.Cuerpo</p>
                    @if (!mensaje.Leido)
                    {
                        <button class="boton-enlace" type="button" @onclick="() => MarcarComoLeidoAsync(mensaje.Id)">Marcar como leído</button>
                    }
                </li>
            }
            @if (!_cargandoMensajes && _mensajes.Count == 0 && _errorMensajes is null)
            {
                <li><p>No tienes mensajes.</p></li>
            }
        </ul>
    </PanelLateral>
</header>

@code {
    private static readonly int[] _tamanosTexto = [100, 125, 150, 200];
    private ElementReference _textoTrigger;
    private ElementReference _textoMenu;
    private ElementReference _usuarioTrigger;
    private ElementReference _usuarioMenu;
    private DotNetObjectReference<TopBar>? _callback;
    private bool _textoVinculado;
    private bool _usuarioVinculado;
    private bool _textoAbierto;
    private bool _usuarioAbierto;
    private bool _notificacionEmergente;
    private bool _panelMensajesAbierto;
    private string _tema = "light";
    private int _escala = 100;
    private IReadOnlyList<MensajeAlumno> _mensajes = [];
    private int _mensajesSinLeer;
    private bool _cargandoMensajes;
    private string? _errorMensajes;
    private string TextoMensajesSinLeer => _mensajesSinLeer == 1
        ? "1 mensaje sin leer"
        : $"{_mensajesSinLeer} mensajes sin leer";
    private string CssClass => Navigation.ToBaseRelativePath(Navigation.Uri) is ""
        ? "topbar topbar--acceso"
        : "topbar";
    private static string EtiquetaEscala(int tamaño) => tamaño switch
    {
        100 => "Normal 100%",
        125 => "Mediano 125%",
        150 => "Grande 150%",
        200 => "Muy grande 200%",
        _ => throw new ArgumentOutOfRangeException(nameof(tamaño), tamaño, "Tamaño de texto no soportado.")
    };

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += HandleAuthenticationChanged;
        Navigation.LocationChanged += HandleLocationChanged;
        await ActualizarMensajesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var preferencias = await JS.InvokeAsync<Preferencias>("unieval.initializePreferences");
            _tema = preferencias.Theme;
            _escala = int.Parse(preferencias.Scale, System.Globalization.CultureInfo.InvariantCulture);
            _callback = DotNetObjectReference.Create(this);
        }

        if (_callback is not null && !_textoVinculado)
        {
            await JS.InvokeVoidAsync("unieval.bindMenu", _textoTrigger, _textoMenu, _callback, nameof(OpenTextMenu), nameof(CloseTextMenu));
            _textoVinculado = true;
        }

        if (_callback is not null && AuthService.CurrentUser is not null && !_usuarioVinculado)
        {
            await JS.InvokeVoidAsync("unieval.bindMenu", _usuarioTrigger, _usuarioMenu, _callback, nameof(OpenUserMenu), nameof(CloseUserMenu));
            _usuarioVinculado = true;
        }

        if (_callback is not null && AuthService.CurrentUser is null)
        {
            _usuarioVinculado = false;
        }

        if (firstRender)
        {
            StateHasChanged();
        }
    }

    private void ToggleTextMenu()
    {
        _textoAbierto = !_textoAbierto;
        _usuarioAbierto = false;
    }

    private void ToggleUserMenu()
    {
        _usuarioAbierto = !_usuarioAbierto;
        _textoAbierto = false;
    }

    private void AbrirMensajes()
    {
        _notificacionEmergente = false;
        _panelMensajesAbierto = true;
    }

    private async Task MarcarComoLeidoAsync(string id)
    {
        try
        {
            await AlumnoService.MarcarMensajeComoLeidoAsync(id);
            await ActualizarMensajesAsync();
        }
        catch (ArgumentException exception)
        {
            _errorMensajes = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _errorMensajes = exception.Message;
        }
    }

    private async Task MarcarTodosComoLeidosAsync()
    {
        try
        {
            await AlumnoService.MarcarTodosComoLeidosAsync();
            await ActualizarMensajesAsync();
        }
        catch (InvalidOperationException exception)
        {
            _errorMensajes = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _errorMensajes = exception.Message;
        }
    }

    private async Task CambiarEscala(int escala)
    {
        _escala = escala;
        _textoAbierto = false;
        await JS.InvokeVoidAsync("unieval.setTextScale", escala.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

    private async Task CambiarTema()
    {
        _tema = _tema == "dark" ? "light" : "dark";
        await JS.InvokeVoidAsync("unieval.setTheme", _tema);
    }

    private async Task CerrarSesion()
    {
        _usuarioAbierto = false;
        await AuthService.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    [JSInvokable]
    public Task OpenTextMenu()
    {
        _textoAbierto = true;
        _usuarioAbierto = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task CloseTextMenu()
    {
        _textoAbierto = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OpenUserMenu()
    {
        _usuarioAbierto = true;
        _textoAbierto = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task CloseUserMenu()
    {
        _usuarioAbierto = false;
        return InvokeAsync(StateHasChanged);
    }

    private void HandleAuthenticationChanged(Task<AuthenticationState> authenticationState)
    {
        _ = authenticationState;
        _ = InvokeAsync(async () =>
        {
            await ActualizarMensajesAsync();
            StateHasChanged();
        });
    }

    private async Task ActualizarMensajesAsync()
    {
        if (AuthService.CurrentUser?.Role != Rol.Alumno)
        {
            _mensajes = [];
            _mensajesSinLeer = 0;
            _notificacionEmergente = false;
            _errorMensajes = null;
            return;
        }

        _cargandoMensajes = true;
        _errorMensajes = null;
        try
        {
            _mensajes = await AlumnoService.ObtenerMensajesAsync();
            _mensajesSinLeer = await AlumnoService.ObtenerMensajesSinLeerAsync();
            _notificacionEmergente = _mensajesSinLeer > 0;
        }
        catch (InvalidOperationException exception)
        {
            _errorMensajes = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _errorMensajes = exception.Message;

        }
        finally
        {
            _cargandoMensajes = false;
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = sender;
        _ = args;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= HandleAuthenticationChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
        _callback?.Dispose();
    }

    private sealed record Preferencias(string Theme, string Scale);
}
