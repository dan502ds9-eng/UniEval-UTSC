@page "/admin"
@page "/admin/{Seccion}"
@attribute [Authorize(Roles = "Administrador")]

<PageTitle>@(Titulo) · UniEval UTSC</PageTitle>
<StaffShell Rol="Rol.Administrador" Seccion="@Seccion" />

@code {
    [Parameter] public string? Seccion { get; set; }
    private string Titulo => Seccion switch
    {
        "periodos" => "Periodos",
        "carga-academica" => "Carga académica",
        "estadias" => "Estadías",
        "catalogos" => "Catálogos",
        "plantillas" => "Plantillas",
        "seguimiento" => "Seguimiento",
        "resultados-docentes" => "Resultados de docentes",
        "resultados-tutores" => "Resultados de tutores",
        "reportes" => "Reportes",
        _ => "Inicio"
    };
}
