@page "/coordinador"
@page "/coordinador/{Seccion}"
@attribute [Authorize(Roles = "Coordinador")]

<PageTitle>@(Titulo) · UniEval UTSC</PageTitle>
<StaffShell Rol="Rol.Coordinador" Seccion="@Seccion" />

@code {
    [Parameter] public string? Seccion { get; set; }
    private string Titulo => Seccion switch
    {
        "seguimiento" => "Seguimiento",
        "resultados-docentes" => "Resultados de docentes",
        "resultados-tutores" => "Resultados de tutores",
        "reportes" => "Reportes",
        _ => "Inicio"
    };
}
