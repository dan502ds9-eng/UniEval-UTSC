@using System.Globalization

<span class="pill pill--@NivelCss">
    @if (MostrarValor)
    {
        <span>@ValorTexto</span>
    }
    <span>@Nivel</span>
</span>

@code {
    [Parameter] public decimal Value { get; set; }
    [Parameter] public bool MostrarValor { get; set; } = true;

    public string Nivel => ValorRedondeado < 5 ? "Bajo" : ValorRedondeado < 8 ? "Medio" : "Alto";

    private string NivelCss => Nivel.ToLowerInvariant();
    private decimal ValorRedondeado => Math.Round(Value, 1, MidpointRounding.AwayFromZero);
    private string ValorTexto => ValorRedondeado.ToString("0.0", CultureInfo.InvariantCulture);
}
