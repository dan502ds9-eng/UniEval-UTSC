@page "/admin/estadias"
@attribute [Authorize(Roles = "Administrador")]
@inject IEstadiasService EstadiasService

<PageTitle>Estadías · UniEval UTSC</PageTitle>
<ShellAdministrador Seccion="estadias">
    <ChildContent>
        <section class="coordinacion-panel">
            @if (_cargando)
            {
                <p role="status">Cargando…</p>
            }
            else if (_error is not null)
            {
                <p role="alert">@_error</p>
            }
            else
            {
            <h2>Asignación de tutor de estadías</h2>
            <label class="campo">
                <span class="campo__etiqueta">Grupo</span>
                <select class="campo__entrada" value="@_grupoId" @onchange="CambiarGrupo">
                    @foreach (var grupo in _grupos)
                    {
                        <option value="@grupo.Id">@grupo.Nombre</option>
                    }
                </select>
            </label>
            <label class="campo">
                <span class="campo__etiqueta">Tutor para todo el grupo</span>
                <select class="campo__entrada" @onchange="AsignarGrupo">
                    <option value="">Selecciona tutor</option>
                    @foreach (var tutor in _tutores)
                    {
                        <option value="@tutor">@tutor</option>
                    }
                </select>
            </label>
            <div class="tabla-resultados-contenedor">
                <table class="tabla-resultados">
                    <caption>Alumnos y asignaciones de estadías</caption>
                    <thead><tr><th scope="col">Alumno</th><th scope="col">Correo institucional</th><th scope="col">Empresa</th><th scope="col">Tutor de estadías</th></tr></thead>
                    <tbody>
                        @foreach (var alumno in Alumnos)
                        {
                            <tr>
                                <td>@alumno.Nombre</td>
                                <td>@alumno.Correo</td>
                                <td>@alumno.Empresa</td>
                                <td>
                                    <select class="campo__entrada" aria-label="@($"Tutor de estadías de {alumno.Nombre}")"
                                            value="@alumno.TutorId"
                                            @onchange="evento => CambiarTutor(alumno.AlumnoId, evento)">
                                        <option value="">Sin asignar</option>
                                        @foreach (var tutor in _tutores)
                                        {
                                            <option value="@tutor">@tutor</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="resultado-aviso" role="status">@_sinTutor alumnos sin tutor de estadías: no se les generará encuesta.</p>
            <button class="boton" type="button" @onclick="Guardar">Guardar asignaciones</button>
            @if (!string.IsNullOrWhiteSpace(_mensaje))
            {
                <p role="status">@_mensaje</p>
            }
            }
        </section>
    </ChildContent>
</ShellAdministrador>

@code {
    private string _grupoId = string.Empty;
    private string _mensaje = string.Empty;
    private IReadOnlyList<GrupoEstadias> _grupos = [];
    private IReadOnlyList<string> _tutores = [];
    private IReadOnlyList<AsignacionTutorEstadias> _alumnos = [];
    private bool _cargando = true;
    private string? _error;
    private IReadOnlyList<AsignacionTutorEstadias> Alumnos => _alumnos;
    private int _sinTutor => Alumnos.Count(alumno => string.IsNullOrWhiteSpace(alumno.TutorId));

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = null;
        try
        {
            _grupos = await EstadiasService.ObtenerGruposAsync();
            _tutores = await EstadiasService.ObtenerTutoresAsync();
            if (string.IsNullOrEmpty(_grupoId))
            {
                _grupoId = _grupos.FirstOrDefault()?.Id ?? string.Empty;
            }

            if (!string.IsNullOrEmpty(_grupoId))
            {
                _alumnos = await EstadiasService.ObtenerAsignacionesAsync(_grupoId);
            }
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;

        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CambiarGrupo(ChangeEventArgs evento)
    {
        _grupoId = evento.Value?.ToString() ?? throw new InvalidOperationException("Selecciona un grupo.");
        _mensaje = string.Empty;
        _alumnos = await EstadiasService.ObtenerAsignacionesAsync(_grupoId);
    }

    private async Task AsignarGrupo(ChangeEventArgs evento)
    {
        var tutorId = evento.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(tutorId))
        {
            await EstadiasService.AsignarTutorATodoElGrupoAsync(_grupoId, tutorId);
            await RecargarAlumnosAsync();
        }
    }

    private async Task CambiarTutor(string alumnoId, ChangeEventArgs evento)
    {
        await EstadiasService.CambiarTutorAsync(alumnoId, string.IsNullOrWhiteSpace(evento.Value?.ToString())
            ? null
            : evento.Value.ToString());
        await RecargarAlumnosAsync();
    }

    private async Task Guardar()
    {
        await EstadiasService.GuardarAsignacionesAsync(_grupoId);
        _mensaje = "Las asignaciones de estadías se guardaron.";
    }

    private async Task RecargarAlumnosAsync() =>
        _alumnos = await EstadiasService.ObtenerAsignacionesAsync(_grupoId);
}
