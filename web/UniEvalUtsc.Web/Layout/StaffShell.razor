@using UniEvalUtsc.Contracts.Enums

<div class="staff-shell">
    <aside class="staff-shell__sidebar" aria-label="Navegación de @AuthService.Etiqueta(Rol)">
        <div class="staff-shell__perfil">
            <span class="staff-shell__nombre">@AuthService.CurrentUser?.Name</span>
            <span class="staff-shell__rol">@AuthService.Etiqueta(Rol)</span>
        </div>
        <nav class="staff-shell__nav" aria-label="Secciones">
            @foreach (var item in Secciones)
            {
                <NavLink href="@item.Ruta" Match="NavLinkMatch.All" class="staff-shell__enlace" ActiveClass="activo">
                    @item.Etiqueta
                </NavLink>
            }
        </nav>
    </aside>
    <main class="staff-shell__contenido">
        @if (SeccionActual != "inicio")
        {
            <BotonRegresar Href="@AuthService.InicioPorRol(Rol)" />
        }
        <h1 tabindex="-1">@TituloActual</h1>
        <p class="staff-shell__descripcion">@DescripcionActual</p>
        @ChildContent
    </main>
</div>

@code {
    [Inject] private AuthService AuthService { get; set; } = default!;
    [Parameter, EditorRequired] public Rol Rol { get; set; }
    [Parameter] public string? Seccion { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string SeccionActual => string.IsNullOrWhiteSpace(Seccion)
        ? "inicio"
        : Seccion.ToLowerInvariant();

    private IReadOnlyList<SeccionNavegacion> Secciones => Rol switch
    {
        Rol.Docente or Rol.Tutor =>
        [
            CrearSeccion("inicio", "Inicio"),
            CrearSeccion("resultados", "Mis resultados"),
            CrearSeccion("historico", "Histórico"),
            CrearSeccion("reportes", "Reportes")
        ],
        Rol.Coordinador =>
        [
            CrearSeccion("inicio", "Inicio"),
            CrearSeccion("seguimiento", "Seguimiento"),
            CrearSeccion("resultados-docentes", "Resultados de docentes"),
            CrearSeccion("resultados-tutores", "Resultados de tutores"),
            CrearSeccion("reportes", "Reportes")
        ],
        Rol.Administrador =>
        [
            CrearSeccion("inicio", "Inicio"),
            CrearSeccion("periodos", "Periodos"),
            CrearSeccion("carga-academica", "Carga académica"),
            CrearSeccion("estadias", "Estadías"),
            CrearSeccion("catalogos", "Catálogos"),
            CrearSeccion("plantillas", "Plantillas"),
            CrearSeccion("seguimiento", "Seguimiento"),
            CrearSeccion("resultados-docentes", "Resultados de docentes"),
            CrearSeccion("resultados-tutores", "Resultados de tutores"),
            CrearSeccion("reportes", "Reportes")
        ],
        _ => []
    };

    private string TituloActual => Secciones
        .FirstOrDefault(item => item.Ruta.EndsWith($"/{SeccionActual}", StringComparison.Ordinal))
        ?.Etiqueta ?? "Inicio";

    private string DescripcionActual => (Rol, SeccionActual) switch
    {
        (Rol.Docente, "inicio") => "Consulta el resumen de tus evaluaciones.",
        (Rol.Tutor, "inicio") => "Consulta el resumen de tus tutorías.",
        (Rol.Docente, "resultados") => "Consulta tus resultados por materia y periodo.",
        (Rol.Tutor, "resultados") => "Consulta tus resultados por grupo y periodo.",
        (Rol.Docente or Rol.Tutor, "historico") => "Compara tus resultados entre periodos.",
        (Rol.Docente or Rol.Tutor, "reportes") => "Consulta y descarga tus reportes.",
        (Rol.Coordinador, "inicio") => "Consulta los indicadores de participación y desempeño de tu carrera.",
        (Rol.Coordinador, "seguimiento") => "Revisa la participación y envía recordatorios a los grupos.",
        (Rol.Coordinador, "resultados-docentes") => "Consulta los promedios de docentes de tu carrera.",
        (Rol.Coordinador, "resultados-tutores") => "Consulta los promedios de tutores de tu carrera.",
        (Rol.Coordinador, "reportes") => "Genera reportes de participación y resultados.",
        (Rol.Administrador, "inicio") => "Consulta el estado del periodo y los indicadores principales.",
        (Rol.Administrador, "periodos") => "Abre o cierra periodos de evaluación.",
        (Rol.Administrador, "carga-academica") => "Administra docentes y tutorías por grupo.",
        (Rol.Administrador, "estadias") => "Asigna tutores de estadías a alumnos o grupos.",
        (Rol.Administrador, "catalogos") => "Administra carreras, grupos, materias, docentes y alumnos.",
        (Rol.Administrador, "plantillas") => "Edita y publica las plantillas de evaluación.",
        (Rol.Administrador, "seguimiento") => "Revisa la participación de los grupos.",
        (Rol.Administrador, "resultados-docentes") => "Consulta los promedios de docentes.",
        (Rol.Administrador, "resultados-tutores") => "Consulta los promedios de tutores.",
        (Rol.Administrador, "reportes") => "Genera reportes de participación y resultados.",
        _ => $"Consulta la información de {TituloActual.ToLowerInvariant()}."
    };

    private SeccionNavegacion CrearSeccion(string slug, string etiqueta) =>
        new(slug, etiqueta, $"/{(Rol == Rol.Administrador ? "admin" : Rol.ToString().ToLowerInvariant())}/{slug}");

    private sealed record SeccionNavegacion(string Slug, string Etiqueta, string Ruta);
}
