<div class="campo">
    <label class="campo__etiqueta" for="@Id">@Label</label>
    <input id="@Id"
           class="campo__entrada"
           type="@Type"
           value="@Value"
           placeholder="@Placeholder"
           required="@Required"
           disabled="@Disabled"
           aria-describedby="@DescribedBy"
           @oninput="HandleInput" />
    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <span class="campo__ayuda" id="@HelpId">@HelpText</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string? DescribedBy => string.IsNullOrWhiteSpace(HelpText) ? null : HelpId;
    private string HelpId => $"{Id}-ayuda";

    private Task HandleInput(ChangeEventArgs args) =>
        ValueChanged.InvokeAsync(args.Value?.ToString());
}
