<button class="boton-regresar" type="button" @onclick="Volver">
    @Text
</button>
@inject IJSRuntime JS

@code {
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public string Text { get; set; } = "← Volver";

    private Task Volver() => JS.InvokeVoidAsync("unieval.backOrNavigate", Href).AsTask();
}
