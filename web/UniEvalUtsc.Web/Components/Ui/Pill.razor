@using System.Globalization

<span class="pill pill--@NivelCss" aria-label="@AccessibleLabel">
    @if (MostrarValor)
    {
        <span>@ValorTexto</span>
    }
    <span>@Nivel</span>
</span>

@code {
    [Parameter] public decimal Value { get; set; }
    [Parameter] public bool MostrarValor { get; set; } = true;

    public string Nivel => Value < 5 ? "Bajo" : Value < 8 ? "Medio" : "Alto";

    private string NivelCss => Nivel.ToLowerInvariant();
    private string ValorTexto => Value.ToString("0.0", CultureInfo.InvariantCulture);
    private string AccessibleLabel => MostrarValor ? $"{ValorTexto}, {Nivel}" : Nivel;
}
