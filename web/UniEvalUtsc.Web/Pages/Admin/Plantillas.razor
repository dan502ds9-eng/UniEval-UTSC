@page "/admin/plantillas"
@attribute [Authorize(Roles = "Administrador")]
@inject IPlantillasService PlantillasService

<PageTitle>Plantillas · UniEval UTSC</PageTitle>
<ShellAdministrador Seccion="plantillas">
    <ChildContent>
        <section class="coordinacion-panel">
            @if (_cargando)
            {
                <p role="status">Cargando…</p>
            }
            else if (!string.IsNullOrWhiteSpace(_error))
            {
                <p role="alert">@_error</p>
            }
            else
            {
            <h2>Plantillas de evaluación</h2>
            <label class="campo">
                <span class="campo__etiqueta">Formulario</span>
                <select class="campo__entrada" value="@_plantillaId" @onchange="Seleccionar">
                    @foreach (var plantilla in _plantillas)
                    {
                        <option value="@plantilla.Id">@plantilla.Nombre · versión @plantilla.Version · @Etiqueta(plantilla)</option>
                    }
                </select>
            </label>
            <p>Los cambios publicados se aplicarán a partir del siguiente periodo.</p>
            <ol class="plantillas-admin__aspectos">
                @for (var indice = 0; indice < _aspectos.Count; indice++)
                {
                    var index = indice;
                    <li>
                        <div class="plantillas-admin__acciones">
                            <button class="boton boton--enlace" type="button" aria-label="@($"Mover aspecto {index + 1} hacia arriba")"
                                    disabled="@(index == 0 || !EsBorrador)" @onclick="() => MoverAsync(index, -1)">↑</button>
                            <button class="boton boton--enlace" type="button" aria-label="@($"Mover aspecto {index + 1} hacia abajo")"
                                    disabled="@(index == _aspectos.Count - 1 || !EsBorrador)" @onclick="() => MoverAsync(index, 1)">↓</button>
                            <button class="boton boton--enlace" type="button" disabled="@(!EsBorrador)"
                                    @onclick="() => CambiarModoEdicion(index)">
                                @(_editandoIndice == index ? "Listo" : "Editar")
                            </button>
                            <button class="boton boton--enlace" type="button" disabled="@(!EsBorrador || _aspectos.Count <= 1)"
                                    @onclick="() => EliminarAsync(index)">Eliminar</button>
                        </div>
                        @if (EsBorrador && _editandoIndice == index)
                        {
                            <label class="campo">
                                <span class="campo__etiqueta">Aspecto @(index + 1)</span>
                                <textarea class="campo__entrada" rows="2" value="@_aspectos[index].Texto"
                                          @onchange="evento => EditarAsync(index, evento.Value?.ToString() ?? string.Empty)"></textarea>
                            </label>
                        }
                        else
                        {
                            <p><strong>Aspecto @(index + 1):</strong> @_aspectos[index].Texto</p>
                        }
                    </li>
                }
            </ol>
            <div class="plantillas-admin__acciones">
                <button class="boton boton--contorno" type="button" disabled="@EsBorrador" @onclick="CrearBorradorAsync">Crear borrador</button>
                <button class="boton boton--contorno" type="button" disabled="@(!EsBorrador)" @onclick="AgregarAspectoAsync">Agregar aspecto</button>
                <button class="boton" type="button" disabled="@(!EsBorrador || !_cambios)" @onclick="PublicarAsync">Publicar versión @_plantilla?.Version</button>
                <button class="boton boton--contorno" type="button" disabled="@(!EsBorrador)" @onclick="DescartarAsync">Descartar cambios</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_mensaje))
            {
                <p role="status">@_mensaje</p>
            }
            }
        </section>
    </ChildContent>
</ShellAdministrador>

@code {
    private string _plantillaId = string.Empty;
    private PlantillaAdministrativa? _plantilla;
    private IReadOnlyList<PlantillaAdministrativa> _plantillas = [];
    private List<AspectoPlantilla> _aspectos = [];
    private int _editandoIndice = -1;
    private bool _cambios;
    private string _mensaje = string.Empty;
    private string _error = string.Empty;
    private bool _cargando = true;
    private bool EsBorrador => _plantilla?.Borrador == true;
    private string IdBase
    {
        get
        {
            var indice = _plantillaId.IndexOf("-v", StringComparison.Ordinal);
            return indice < 0 ? _plantillaId : _plantillaId[..indice];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = string.Empty;
        try
        {
            _plantillas = await PlantillasService.ObtenerPlantillasAsync();
            if (string.IsNullOrEmpty(_plantillaId))
            {
                _plantillaId = _plantillas.First().Id;
            }

            await CargarPlantillaAsync();
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task Seleccionar(ChangeEventArgs evento)
    {
        _plantillaId = evento.Value?.ToString()
            ?? throw new InvalidOperationException("Selecciona una plantilla.");
        await CargarPlantillaAsync();
    }

    private async Task CargarPlantillaAsync()
    {
        _plantilla = await PlantillasService.ObtenerAsync(_plantillaId);
        _aspectos = _plantilla.Aspectos.ToList();
        _editandoIndice = -1;
        _cambios = false;
        _mensaje = string.Empty;
        _error = string.Empty;
    }

    private Task CrearBorradorAsync()
    {
        return EjecutarAsync(async () =>
        {
            _plantilla = await PlantillasService.CrearBorradorAsync(IdBase);
            _plantillaId = _plantilla.Id;
            await CargarPlantillaAsync();
            _mensaje = "Se creó un borrador editable.";
        });
    }

    private async Task EditarAsync(int indice, string texto)
    {
        _aspectos[indice] = _aspectos[indice] with { Texto = texto };
        await GuardarCambiosAsync();
    }

    private async Task MoverAsync(int indice, int desplazamiento)
    {
        var destino = indice + desplazamiento;
        (_aspectos[indice], _aspectos[destino]) = (_aspectos[destino], _aspectos[indice]);
        if (_editandoIndice == indice)
        {
            _editandoIndice = destino;
        }
        else if (_editandoIndice == destino)
        {
            _editandoIndice = indice;
        }

        await GuardarCambiosAsync();
    }

    private async Task EliminarAsync(int indice)
    {
        _aspectos.RemoveAt(indice);
        if (_editandoIndice == indice)
        {
            _editandoIndice = -1;
        }
        else if (_editandoIndice > indice)
        {
            _editandoIndice--;
        }

        await GuardarCambiosAsync();
    }

    private async Task AgregarAspectoAsync()
    {
        _aspectos.Add(new AspectoPlantilla(_aspectos.Count + 1, "Nuevo aspecto"));
        _editandoIndice = _aspectos.Count - 1;
        await GuardarCambiosAsync();
    }

    private void CambiarModoEdicion(int indice) =>
        _editandoIndice = _editandoIndice == indice ? -1 : indice;

    private async Task GuardarCambiosAsync()
    {
        try
        {
            await PlantillasService.ReemplazarAspectosAsync(_plantillaId, _aspectos);
            _plantilla = await PlantillasService.ObtenerAsync(_plantillaId);
            _aspectos = _plantilla.Aspectos.ToList();
            _cambios = true;
            _error = string.Empty;
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;
        }
    }

    private Task PublicarAsync() => EjecutarAsync(async () =>
    {
        await PlantillasService.PublicarAsync(_plantillaId);
        await CargarAsync();
        _mensaje = "La nueva versión quedó publicada y se aplicará a partir del siguiente periodo.";
    });

    private Task DescartarAsync() => EjecutarAsync(async () =>
    {
        await PlantillasService.DescartarAsync(_plantillaId);
        _plantillas = await PlantillasService.ObtenerPlantillasAsync();
        _plantillaId = _plantillas.First(plantilla => plantilla.Id == IdBase).Id;
        await CargarPlantillaAsync();
        _mensaje = "Se descartó el borrador.";
    });

    private async Task EjecutarAsync(Func<Task> accion)
    {
        _mensaje = string.Empty;
        _error = string.Empty;
        try
        {
            await accion();
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;

        }
    }

    private static string Etiqueta(PlantillaAdministrativa plantilla) => plantilla.Borrador
        ? "Borrador"
        : plantilla.Vigente ? "Vigente" : "Anterior";
}
