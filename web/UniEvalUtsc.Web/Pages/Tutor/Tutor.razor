@page "/tutor"
@page "/tutor/{Seccion}"
@attribute [Authorize(Roles = "Tutor")]

<PageTitle>@(Titulo) · UniEval UTSC</PageTitle>
<StaffShell Rol="Rol.Tutor" Seccion="@Seccion" />

@code {
    [Parameter] public string? Seccion { get; set; }
    private string Titulo => Seccion switch
    {
        "resultados" => "Mis resultados",
        "historico" => "Histórico",
        "reportes" => "Reportes",
        _ => "Inicio"
    };
}
