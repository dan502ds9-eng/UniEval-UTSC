@inject ICoordinacionService CoordinacionService

<section class="coordinacion-contenido">
    @if (_cargando)
    {
        <p role="status">Cargando…</p>
    }
    else if (_error is not null)
    {
        <p role="alert">@_error</p>
    }
    else
    {
    <IndicadoresGestion Resumen="@_resumen" />

    <section class="coordinacion-panel">
        <div class="coordinacion-panel__encabezado">
            <h2>Menor participación</h2>
            <a class="boton boton--enlace" href="@RutaSeguimiento">Ver seguimiento →</a>
        </div>
        <ol class="menor-participacion">
            @foreach (var grupo in _grupos)
            {
                <li>
                <span>@grupo.Nombre<small class="tabla-resultados__secundario">@EtiquetaGrupo(grupo)</small></span>
                    <strong>@grupo.Porcentaje.ToString("0.#")%</strong>
                </li>
            }
        </ol>
    </section>

    <section class="coordinacion-panel">
        <div class="coordinacion-panel__encabezado">
            <h2>Áreas de mejora</h2>
            <a class="boton boton--enlace" href="@RutaResultadosDocentes">Ver todo →</a>
        </div>
        @if (_areasMejora.Count == 0)
        {
            <p>No hay resultados disponibles para estos filtros.</p>
        }
        else
        {
            <ul class="areas-mejora">
                @foreach (var resultado in _areasMejora)
                {
                    <li>
                        <span>@resultado.Nombre<small class="tabla-resultados__secundario">@resultado.Contexto</small></span>
                        <span><strong>@resultado.Promedio.ToString("0.0")</strong> <Pill Value="@resultado.Promedio" MostrarValor="false" /></span>
                    </li>
                }
            </ul>
        }
    </section>
    }
</section>

@code {
    [Parameter, EditorRequired] public string PeriodoId { get; set; } = string.Empty;
    [Parameter] public string Cuatrimestre { get; set; } = "todos";
    [Parameter] public string CarreraId { get; set; } = FiltrosState.CarreraCoordinadorId;
    [Parameter] public string RutaSeguimiento { get; set; } = "/coordinador/seguimiento";
    [Parameter] public string RutaResultadosDocentes { get; set; } = "/coordinador/resultados-docentes";

    private ResumenCoordinacion _resumen = new(0, 0, 0, 0, 0);
    private IReadOnlyList<GrupoParticipacion> _grupos = [];
    private IReadOnlyList<ResultadoCoordinacion> _areasMejora = [];
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _error = null;
        try
        {
            _resumen = await CoordinacionService.ObtenerResumenAsync(PeriodoId, Cuatrimestre, CarreraId);
            _grupos = (await CoordinacionService.ObtenerGruposAsync(PeriodoId, Cuatrimestre, CarreraId))
                .OrderBy(grupo => grupo.Porcentaje)
                .Take(3)
                .ToArray();
            _areasMejora = (await CoordinacionService.ObtenerResultadosAsync(PeriodoId, Cuatrimestre, tutores: false, CarreraId))
                .Where(resultado => resultado.Promedio < 8)
                .Take(3)
                .ToArray();
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private static string EtiquetaGrupo(GrupoParticipacion grupo) => grupo.Cuatrimestre switch
    {
        6 => "6to · estadías",
        10 => "10mo · estadías",
        _ => "5to cuatrimestre"
    };
}
